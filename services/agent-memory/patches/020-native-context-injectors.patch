diff --git a/MemoryProxy/src/routes/multica-context.ts b/MemoryProxy/src/routes/multica-context.ts
new file mode 100644
index 0000000..f2fc5bb
--- /dev/null
+++ b/MemoryProxy/src/routes/multica-context.ts
@@ -0,0 +1,77 @@
+import type { Context } from "hono";
+import type { ProxyConfig } from "../types.js";
+import type { InjectionHook, PrewarmInput } from "../injection/types.js";
+import { TdaiProfileMemoryInjector } from "../injection/injectors/tdai-profile-memory-injector.js";
+import { SkillInjector } from "../injection/injectors/skill-injector.js";
+import { KnowledgeToolsInjector } from "../injection/injectors/knowledge-tools-injector.js";
+import { CoreSkillClient } from "../skill/core-client.js";
+import { CoreKnowledgeClient } from "../knowledge/core-client.js";
+import { getMetadataClient } from "../meta/client.js";
+import { checkAdminAuth } from "./admin-auth.js";
+
+const MEMORY_GUIDE = `<memory-tools-guide>
+L3 long-term memory and the L2 scene index are provided below. L0/L1 history is retrieved on demand.
+When a request depends on past work, preferences, decisions or lessons, search before answering:
+multica knowledge search "<keywords>" --type chat_memory
+Search at most three times per turn. If nothing matches, say so; do not invent history.
+For an L2 scene, use its source asset ID and indexed path:
+multica knowledge read <asset-id> --layer L2 --ref <scene-path>
+Use multica knowledge list to find chat_memory asset IDs. Their format is chat_memory-<team_id>-<agent_id>, matching each profile group below.
+Read L0, L1 or L3 with --layer L0|L1|L3. Do not repeatedly read the same scene.
+</memory-tools-guide>`;
+const SKILL_GUIDE = `## Skills
+Scan the available skills before replying. Load a relevant skill with multica knowledge read <skill-id>, using the id in the catalog, and apply its relevant workflow within the current user's instructions and permissions.
+Read a supporting file with multica knowledge read <skill-id> --ref <file-path>.
+Search additional bound skills with multica knowledge search "<keywords>" --type skill; paginate the catalog with multica knowledge list --offset <offset>.
+Memory tools are read-only. Task Done triggers extraction; do not create or patch memory through a bridge.`;
+const KNOWLEDGE_GUIDE = `Wiki contains design background, decisions and experience. Use it when an answer depends on that history.
+CodeGraph is a repository snapshot: match its repository before using it for cross-file structure or relationships; use local source when exact current code matters.
+Search with multica knowledge search "<keywords>" --type llm_wiki or --type code_graph.
+Read a Wiki page with multica knowledge read <asset-id> --ref <page-reference>.
+Explore code with multica knowledge read <asset-id> --query <symbol-or-topic>.
+Use returned IDs and references. Read relevant pages on demand instead of loading every document.`;
+
+/** Internal read-only host adapter. No model forwarding, session registration or archive hooks. */
+export function createMulticaContextHandler(config: ProxyConfig) {
+  return async (c: Context): Promise<Response> => {
+    const reply = (status: 200 | 400 | 401 | 403 | 413, data: unknown) => c.json({ code: status === 200 ? 0 : status, data }, status);
+    // Unlike optional native admin routes, an unconfigured credential fails closed.
+    if (!config.auth.serviceToken || checkAdminAuth(c, config.auth.serviceToken) !== "ok") return reply(401, null);
+    if (Number(c.req.header("content-length") || 0) > 256_000) return reply(413, null);
+    let body: Record<string, unknown>;
+    try { body = await c.req.json(); } catch { return reply(400, null); }
+    if (!body || typeof body !== "object") return reply(400, null);
+    const ids = [c.req.header("x-tdai-service-id"), body.team_id, body.agent_id, body.user_id, body.session_id];
+    if (ids.some(v => typeof v !== "string" || !/^[a-zA-Z0-9_-]{1,256}$/.test(v))) return reply(400, null);
+    const [spaceId, teamId, agentId, userId, sessionId] = ids as string[];
+    const userKey = c.req.header("x-tdai-user-key");
+    const assets = body.assets;
+    if (!userKey || !Array.isArray(assets) || assets.length > 1000 || assets.some(a => !a || typeof a.asset_id !== "string" || typeof a.asset_type !== "string")) return reply(400, null);
+    const core = { ...config.coreSkill, serviceId: spaceId, timeoutMs: 1500 };
+    try {
+      const agent = await getMetadataClient(core, spaceId, userKey).getAgent(agentId);
+      if (agent.team_id !== teamId || agent.owner_user_id !== userId || agent.status !== "active") return reply(403, null);
+    } catch { return reply(403, null); }
+    const allowed = assets.map(a => a.asset_id as string);
+    const input: PrewarmInput = {
+      keyId: sessionId, userId, agentSource: "multica", spaceId, callerUserKey: userKey,
+      sessionInfo: { session_id: sessionId, team_id: teamId, agent_id: agentId, user_id: userId, user_key: userKey, space_id: spaceId, created_at: new Date().toISOString() },
+      agentDetail: null, taskDetail: null,
+    };
+    const warnings: string[] = [];
+    // New clients per build avoid native stale-if-error catalogs after revocation.
+    const hooks: InjectionHook[] = [
+      new TdaiProfileMemoryInjector({ enabled: true, endpoint: config.tdai.endpoint, apiKey: config.tdai.apiKey, serviceId: spaceId, writeL0: false, recallL1: false, injectL2L3: true, l1Limit: 0, l2Limit: config.tdai.memory.l2Limit, timeoutMs: 1500 }, core, { toolsGuide: MEMORY_GUIDE, allowedAssetIds: allowed }),
+      new SkillInjector({ coreSkill: core, allowedSkillIds: assets.filter(a => a.asset_type === "skill").map(a => a.asset_id), toolsGuide: SKILL_GUIDE, onError: () => warnings.push("Skill catalog is unavailable; use knowledge list/search to retry.") }, new CoreSkillClient(core)),
+      new KnowledgeToolsInjector({ coreSkill: core, allowedAssetIds: allowed, toolsGuide: KNOWLEDGE_GUIDE, onError: () => warnings.push("Wiki/CodeGraph catalog is unavailable; use knowledge list/search to retry.") }, new CoreKnowledgeClient(core)),
+    ];
+    const built = await Promise.allSettled(hooks.map(h => h.prewarm!(input)));
+    const blocks = built.flatMap((result, i) => {
+      if (result.status === "fulfilled") return result.value;
+      warnings.push(`${hooks[i].id} is unavailable; use knowledge list/search to retry.`);
+      return [];
+    });
+    const memoryCatalog = assets.filter(a => a.asset_type === "chat_memory").map(a => JSON.stringify({asset_id:a.asset_id, name:a.name})).join("\n");
+    return reply(200, { content: ["<memory_catalog>\n"+memoryCatalog+"\n</memory_catalog>", ...blocks.map(b => b.content)].join("\n\n"), sources: blocks.map(b => b.metadata?.source).filter(Boolean), warnings });
+  };
+}
