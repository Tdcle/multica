@@ -0,0 +1,8 @@
+// Set by the authenticated embedding bootstrap before loading the panel.
+declare global {
+  interface Window {
+    __MULTICA_PANEL_CONTEXT__?: { can_manage_space: boolean };
+  }
+}
+
+export const multicaEmbed = window.__MULTICA_PANEL_CONTEXT__;
