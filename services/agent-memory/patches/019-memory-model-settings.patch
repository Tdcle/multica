diff --git a/MemoryPanel/web/src/lib/api/model-settings.ts b/MemoryPanel/web/src/lib/api/model-settings.ts
new file mode 100644
index 0000000..e7ba1de
--- /dev/null
+++ b/MemoryPanel/web/src/lib/api/model-settings.ts
@@ -0,0 +1,22 @@
+import { getPanelSession } from '../panelSession';
+
+export interface ModelOption { id: string; name: string; default_effort: string; efforts: string[] }
+export interface ModelSettings { model: string; effort: string; models: ModelOption[] }
+
+export async function memoryModelSettings(action: 'get' | 'set', teamId: string, selected?: { model: string; effort: string }): Promise<ModelSettings> {
+  const session = getPanelSession();
+  const res = await fetch(`/api/v1/knowledge/model-settings/${action}`, {
+    method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Tdai-Service-Id': session?.instanceId ?? '', 'X-Tdai-User-Key': session?.userKey ?? '' },
+    body: JSON.stringify({ team_id: teamId, ...selected }),
+  });
+  const envelope = await res.json();
+  if (!res.ok || envelope?.code !== 0) throw new Error(envelope?.message || 'Model settings unavailable');
+  const data = envelope.data;
+  // Validate this boundary before selections reach the settings form.
+  if (!data || typeof data.model !== 'string' || typeof data.effort !== 'string' || !Array.isArray(data.models) || data.models.length === 0 || !data.models.every((m: unknown) => {
+    if (typeof m !== 'object' || m === null) return false;
+    const model = m as Record<string, unknown>;
+    return typeof model.id === 'string' && typeof model.name === 'string' && typeof model.default_effort === 'string' && Array.isArray(model.efforts) && model.efforts.every((e: unknown) => typeof e === 'string');
+  })) throw new Error('Invalid model settings response');
+  return data;
+}
