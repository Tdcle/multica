+export interface WikiIngestProgress {
+  phase: 'extracting' | 'merging' | 'indexing';
+  total: number; completed: number; failed: number; skipped: number; percent: number;
+}
+
+export function parseWikiProgress(value: unknown): WikiIngestProgress | null {
+  if (!value || typeof value !== 'object') return null;
+  const p = value as Record<string, unknown>;
+  if (!['extracting', 'merging', 'indexing'].includes(String(p.phase))) return null;
+  if (!['total', 'completed', 'failed', 'skipped', 'percent'].every(key => typeof p[key] === 'number' && Number.isFinite(p[key]) && (p[key] as number) >= 0)) return null;
+  if ((p.percent as number) > 100 || (p.completed as number) + (p.failed as number) > (p.total as number)) return null;
+  return p as unknown as WikiIngestProgress;
+}
