diff --git a/MemoryPanel/src/panel/http/routes/knowledge/model-settings-routes.ts b/MemoryPanel/src/panel/http/routes/knowledge/model-settings-routes.ts
new file mode 100644
index 0000000..8dc0856
--- /dev/null
+++ b/MemoryPanel/src/panel/http/routes/knowledge/model-settings-routes.ts
@@ -0,0 +1,33 @@
+import type { Hono } from 'hono';
+import type { PanelDeps } from '../../../panel-deps.js';
+import { validatePanelMetaHeaders } from '../../middleware/validate-panel-headers.js';
+import { respondControlError, respondEnvelope } from '../../envelope.js';
+import { buildCtx, readJson, str, requireTeamMember, okEnvelope } from './common.js';
+
+export function registerModelSettingsRoutes(api: Hono, deps: PanelDeps): void {
+  const mw = validatePanelMetaHeaders(deps);
+  for (const action of ['get', 'set']) api.post(`/knowledge/model-settings/${action}`, mw, async c => {
+    const ctx = buildCtx(c);
+    const body = await readJson(c);
+    const teamId = str(body, 'team_id');
+    if (!teamId) return respondControlError(c, 400, 'MISSING_TEAM_ID');
+    const gate = await requireTeamMember(deps, c, ctx, teamId);
+    if ('error' in gate) return gate.error;
+    if (action === 'set') {
+      const member = await deps.metaKernel.invoke('team-member/get', { team_id: teamId, user_id: gate.userId }, ctx);
+      if (member.code !== 0 || (member.data as { role?: string } | null)?.role !== 'admin') return respondControlError(c, 403, 'ADMIN_REQUIRED');
+    }
+    const url = process.env.MULTICA_MEMORY_RUNTIME_URL;
+    const token = process.env.MULTICA_MEMORY_RUNTIME_TOKEN;
+    if (!url || !token) return respondControlError(c, 503, 'MODEL_SETTINGS_UNAVAILABLE');
+    try {
+      const response = await fetch(`${url}/settings/${action}`, {
+        method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
+        body: JSON.stringify({ instance_id: ctx.instanceId, team_id: teamId, model: body.model, effort: body.effort }),
+        signal: AbortSignal.timeout(15_000),
+      });
+      if (!response.ok) return respondControlError(c, response.status === 400 ? 400 : 503, response.status === 400 ? 'INVALID_MODEL_OR_EFFORT' : 'MODEL_SETTINGS_UNAVAILABLE');
+      return respondEnvelope(c, okEnvelope(c, await response.json()));
+    } catch { return respondControlError(c, 503, 'MODEL_SETTINGS_UNAVAILABLE'); }
+  });
+}
diff --git a/MemoryPanel/web/src/components/MemoryModelSettings.tsx b/MemoryPanel/web/src/components/MemoryModelSettings.tsx
new file mode 100644
index 0000000..3614dcc
--- /dev/null
+++ b/MemoryPanel/web/src/components/MemoryModelSettings.tsx
@@ -0,0 +1,55 @@
+import { useEffect, useState } from 'react';
+import { Alert, Button, Select, Text } from 'tea-component';
+import { useTranslation } from 'react-i18next';
+import { useTeams } from '@/services';
+import { multicaEmbed } from '@/lib/multicaEmbed';
+import { memoryModelSettings, type ModelSettings } from '@/lib/api/model-settings';
+
+export function MemoryModelSettings() {
+  const { t } = useTranslation();
+  const { activeTeamId } = useTeams();
+  const [settings, setSettings] = useState<ModelSettings | null>(null);
+  const [model, setModel] = useState('');
+  const [effort, setEffort] = useState('');
+  const [saving, setSaving] = useState(false);
+  const [error, setError] = useState('');
+  const [saved, setSaved] = useState(false);
+  const canManage = multicaEmbed?.can_manage_space === true;
+  useEffect(() => {
+    let cancelled = false;
+    setSettings(null); setError(''); setSaved(false);
+    if (activeTeamId) void memoryModelSettings('get', activeTeamId).then(data => {
+      if (!cancelled) { setSettings(data); setModel(data.model); setEffort(data.effort); }
+    }).catch(e => { if (!cancelled) setError(e instanceof Error ? e.message : String(e)); });
+    return () => { cancelled = true; };
+  }, [activeTeamId]);
+  async function save() {
+    if (!activeTeamId) return;
+    setSaving(true); setError(''); setSaved(false);
+    try {
+      const data = await memoryModelSettings('set', activeTeamId, { model, effort });
+      setSettings(data); setModel(data.model); setEffort(data.effort); setSaved(true);
+    } catch (e) { setError(e instanceof Error ? e.message : String(e)); }
+    finally { setSaving(false); }
+  }
+  const selected = settings?.models.find(m => m.id === model);
+  return <section style={{ marginBottom: 24, paddingBottom: 20, borderBottom: '1px solid var(--tea-color-border-primary-default)' }}>
+    <Text style={{ display: 'block', fontWeight: 500, marginBottom: 8 }}>{t('settings.model.title')}</Text>
+    <Text theme="weak" style={{ display: 'block', fontSize: 12, marginBottom: 16 }}>{t('settings.model.description')}</Text>
+    {error && <Alert type="error" style={{ marginBottom: 12 }}>{error}</Alert>}
+    <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 12 }}>
+      <label><Text style={{ display: 'block', marginBottom: 6 }}>{t('settings.model.name')}</Text>
+        <Select aria-label={t('settings.model.name')} value={model} options={settings?.models.map(m => ({ value: m.id, text: m.name })) ?? []}
+          disabled={!settings || !canManage || saving} onChange={value => { setModel(value); setEffort(settings?.models.find(m => m.id === value)?.default_effort ?? ''); setSaved(false); }} style={{ width: '100%' }} />
+      </label>
+      <label><Text style={{ display: 'block', marginBottom: 6 }}>{t('settings.model.effort')}</Text>
+        <Select aria-label={t('settings.model.effort')} value={effort} options={selected?.efforts.map(value => ({ value, text: t(`settings.model.effort.${value}`, { defaultValue: value }) })) ?? []}
+          disabled={!settings || !canManage || saving} onChange={value => { setEffort(value); setSaved(false); }} style={{ width: '100%' }} />
+      </label>
+    </div>
+    <div style={{ display: 'flex', alignItems: 'center', gap: 12, marginTop: 16 }}>
+      {canManage ? <Button type="primary" disabled={!settings || !selected?.efforts.includes(effort) || saving || (settings.model === model && settings.effort === effort)} onClick={() => void save()}>{t(saving ? 'settings.model.saving' : 'settings.model.save')}</Button> : <Text theme="weak">{t('settings.model.adminOnly')}</Text>}
+      {saved && <Text theme="weak">{t('settings.model.saved')}</Text>}
+    </div>
+  </section>;
+}
