diff --git a/MemoryPanel/web/src/lib/multica-view-state.ts b/MemoryPanel/web/src/lib/multica-view-state.ts
new file mode 100644
index 0000000..6817907
--- /dev/null
+++ b/MemoryPanel/web/src/lib/multica-view-state.ts
@@ -0,0 +1,96 @@
+import { useLayoutEffect, useState } from 'react';
+import { multicaEmbed } from './multicaEmbed';
+
+type Value = string | number | boolean | null;
+const saved = multicaEmbed?.view_state;
+const values: Record<string, Value> = saved?.values ?? {};
+let scroll = saved?.scroll ?? {};
+let route = location.hash.slice(1);
+let restoring = !!saved;
+let cancelRestore = () => {};
+
+function publish() {
+  if (!multicaEmbed) return;
+  window.parent.postMessage({ type: 'multica-memory-position-write',
+    position: JSON.stringify({ route, values, scroll }) }, '*');
+}
+
+// Only explicitly opted-in navigation primitives cross the sandbox boundary.
+// Credentials, fetched content, edit drafts and open dialogs remain private.
+export function useMulticaViewState<T extends Value>(key: string, initial: T) {
+  const [value, setValue] = useState<T>(() => {
+    const previous = values[key];
+    return multicaEmbed && (initial === null ? (previous === null || typeof previous === 'string') : typeof previous === typeof initial)
+      && previous !== undefined ? previous as T : initial;
+  });
+  useLayoutEffect(() => {
+    if (!multicaEmbed) return;
+    values[key] = value;
+    publish();
+  }, [key, value]);
+  return [value, setValue] as const;
+}
+
+export function recordMulticaRoute(path: string) {
+  if (!multicaEmbed || route === path) return;
+  cancelRestore();
+  route = path;
+  scroll = {};
+  restoring = false;
+  publish();
+}
+
+if (multicaEmbed) {
+  // A stable CSS path identifies independently scrolling panes, including lists
+  // and document bodies. Offsets are scoped to the currently restored route.
+  const selector = (element: Element) => {
+    const parts: string[] = [];
+    for (let node: Element | null = element; node && node !== document.body; node = node.parentElement) {
+      const siblings = node.parentElement ? Array.from(node.parentElement.children).filter(e => e.tagName === node!.tagName) : [];
+      parts.unshift(`${node.tagName.toLowerCase()}:nth-of-type(${siblings.indexOf(node) + 1})`);
+    }
+    for (const name of element.classList) {
+      if (!name.startsWith('_')) continue;
+      const candidate = '.' + CSS.escape(name);
+      if (document.querySelectorAll(candidate).length === 1) return candidate;
+    }
+    return 'body > ' + parts.join(' > ');
+  };
+
+  document.addEventListener('scroll', event => {
+    if (restoring) return;
+    const element = event.target === document ? document.scrollingElement : event.target;
+    if (!(element instanceof HTMLElement)) return;
+    const key = element === document.scrollingElement ? ':root' : selector(element);
+    scroll[key] = { top: element.scrollTop, left: element.scrollLeft };
+    publish();
+  }, true);
+  if (saved) {
+    const pending = new Map(Object.entries(scroll));
+    const stop = () => {
+      restoring = false; observer.disconnect(); clearTimeout(timeout);
+      for (const event of ['pointerdown', 'wheel', 'keydown']) window.removeEventListener(event, stop);
+    };
+    cancelRestore = stop;
+    const restore = () => {
+      for (const [key, offset] of pending) {
+        let element: Element | null;
+        try { element = key === ':root' ? document.scrollingElement : document.querySelector(key); }
+        catch { pending.delete(key); continue; }
+        if (!(element instanceof HTMLElement) || !Number.isFinite(offset.top) || !Number.isFinite(offset.left)) continue;
+        if (element.scrollHeight - element.clientHeight < offset.top || element.scrollWidth - element.clientWidth < offset.left) continue;
+        element.scrollTop = offset.top;
+        element.scrollLeft = offset.left;
+        pending.delete(key);
+      }
+      if (!pending.size) stop();
+    };
+    // Content loads asynchronously; retry on actual DOM changes, bounded to
+    // ten seconds. User input always takes precedence over a pending restore.
+    const observer = new MutationObserver(restore);
+    observer.observe(document.body, { subtree: true, childList: true, attributes: true });
+    const timeout = setTimeout(stop, 10_000);
+    for (const event of ['pointerdown', 'wheel', 'keydown']) window.addEventListener(event, stop, { once: true });
+    restore();
+  }
+}
