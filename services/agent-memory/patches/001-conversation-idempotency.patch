+// A durable L1 cursor proves processing, including a valid empty extraction.
+// Queue emptiness alone cannot distinguish success from a failed worker.
+async function handleConversationStatus(body: unknown, auth: V2AuthContext, requestId: string, deps: V2RouterDeps): Promise<ApiResponseEnvelope> {
+  const input = body as Record<string, unknown>;
+  const sessionId = input.session_id;
+  if (typeof sessionId !== "string" || !sessionId || sessionId.length > 256) {
+    return errorEnvelope(400, "session_id is required", requestId);
+  }
+  const store = deps.getStore();
+  const storage = deps.getStorage();
+  if (!store?.queryL0Paginated || !storage) return errorEnvelope(503, "Extraction status is unavailable", requestId);
+  const iso = deps.requestIsolation;
+  let latest = 0;
+  let count = 0;
+  for (let offset = 0; ; offset += 100) {
+    const page = await store.queryL0Paginated({
+      sessionId, teamId: iso?.teamId, agentId: iso?.agentId, userId: iso?.userId,
+      limit: 100, offset,
+    });
+    count = page.total;
+    for (const row of page.rows) latest = Math.max(latest, new Date(row.recorded_at).getTime());
+    if (page.rows.length === 0 || offset + page.rows.length >= page.total) break;
+  }
+  const checkpoint = new CheckpointManager("", deps.logger, storage);
+  const cp = await checkpoint.read();
+  const cursor = checkpoint.getRunnerState(cp, sessionId).last_l1_cursor;
+  return successEnvelope({ message_count: count, l1_complete: count > 0 && latest > 0 && cursor >= latest }, requestId);
+}
