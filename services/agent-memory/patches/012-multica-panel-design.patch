new file mode 100644
index 0000000..a878004
--- /dev/null
+++ b/MemoryPanel/web/src/components/multica-icons.tsx
@@ -0,0 +1,97 @@
+import {
+  Plus,
+  PanelsTopLeft,
+  ArrowLeft,
+  Paperclip,
+  BookOpen,
+  ChartColumn,
+  Brain,
+  CircleCheck,
+  Check,
+  ChevronDown,
+  ChevronRight,
+  CircleX,
+  X,
+  Code2,
+  LayoutDashboard,
+  Trash2,
+  Pencil,
+  File,
+  ClipboardPaste,
+  Folder,
+  FolderOpen,
+  Info,
+  Globe,
+  Layers,
+  LoaderCircle,
+  LockKeyhole,
+  Ellipsis,
+  RefreshCw,
+  Search,
+  Settings,
+  Star,
+  Clock,
+  Wrench,
+  Upload,
+  UserRound,
+  UsersRound,
+  List,
+  LayoutGrid,
+  type LucideIcon,
+  type LucideProps,
+} from 'lucide-react';
+
+// Native icons accept named sizes and default to 16px; keep that contract.
+function memoryIcon(Icon: LucideIcon, defaults: LucideProps = {}) {
+  return function MemoryIcon({ size = 16, className = '', ...props }: LucideProps) {
+    const pixels = size === 'large' ? 32 : size === 'medium' ? 20 : size === 'small' ? 12 : size;
+    return (
+      <Icon
+        {...defaults}
+        {...props}
+        size={pixels}
+        className={`${defaults.className || ''} ${className}`}
+      />
+    );
+  };
+}
+
+export const AddIcon = memoryIcon(Plus);
+export const AppIcon = memoryIcon(PanelsTopLeft);
+export const ArrowLeftIcon = memoryIcon(ArrowLeft);
+export const AttachIcon = memoryIcon(Paperclip);
+export const BooksIcon = memoryIcon(BookOpen);
+export const ChartBarIcon = memoryIcon(ChartColumn);
+export const ChatIcon = memoryIcon(Brain);
+export const CheckCircleIcon = memoryIcon(CircleCheck);
+export const CheckIcon = memoryIcon(Check);
+export const ChevronDownIcon = memoryIcon(ChevronDown);
+export const ChevronRightIcon = memoryIcon(ChevronRight);
+export const CloseCircleIcon = memoryIcon(CircleX);
+export const CloseIcon = memoryIcon(X);
+export const CodeIcon = memoryIcon(Code2);
+export const DashboardIcon = memoryIcon(LayoutDashboard);
+export const DeleteIcon = memoryIcon(Trash2);
+export const EditIcon = memoryIcon(Pencil);
+export const FileIcon = memoryIcon(File);
+export const FilePasteIcon = memoryIcon(ClipboardPaste);
+export const FolderIcon = memoryIcon(Folder);
+export const FolderOpenIcon = memoryIcon(FolderOpen);
+export const InfoCircleIcon = memoryIcon(Info);
+export const InternetIcon = memoryIcon(Globe);
+export const LayersIcon = memoryIcon(Layers);
+export const LoadingIcon = memoryIcon(LoaderCircle, { className: 'memory-icon-loading' });
+export const LockOnIcon = memoryIcon(LockKeyhole);
+export const MoreIcon = memoryIcon(Ellipsis);
+export const RefreshIcon = memoryIcon(RefreshCw);
+export const SearchIcon = memoryIcon(Search);
+export const SettingIcon = memoryIcon(Settings);
+export const StarFilledIcon = memoryIcon(Star, { fill: 'currentColor' });
+export const StarIcon = memoryIcon(Star);
+export const TimeIcon = memoryIcon(Clock);
+export const ToolsIcon = memoryIcon(Wrench);
+export const UploadIcon = memoryIcon(Upload);
+export const UserIcon = memoryIcon(UserRound);
+export const UsergroupIcon = memoryIcon(UsersRound);
+export const ViewListIcon = memoryIcon(List);
+export const ViewModuleIcon = memoryIcon(LayoutGrid);
