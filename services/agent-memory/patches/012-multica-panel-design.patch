diff --git a/MemoryPanel/web/src/lib/multica-appearance.ts b/MemoryPanel/web/src/lib/multica-appearance.ts
new file mode 100644
index 0000000..8bd4cfc
--- /dev/null
+++ b/MemoryPanel/web/src/lib/multica-appearance.ts
@@ -0,0 +1,15 @@
+import i18n from '@/i18n';
+import { multicaEmbed } from './multicaEmbed';
+
+if (multicaEmbed) {
+  document.documentElement.dataset.multicaMemory = '';
+  window.addEventListener('message', (event: MessageEvent) => {
+    if (event.source !== window.parent || event.data?.type !== 'multica-memory-appearance') return;
+    if (typeof event.data.dark !== 'boolean' || typeof event.data.language !== 'string') return;
+    document.documentElement.classList.toggle('dark', event.data.dark);
+    document.documentElement.lang = event.data.language;
+    const language = event.data.language.startsWith('zh') ? 'zh-CN' : 'en-US';
+    if (i18n.language !== language) void i18n.changeLanguage(language);
+  });
+  window.parent.postMessage({ type: 'multica-memory-appearance-read' }, '*');
+}
