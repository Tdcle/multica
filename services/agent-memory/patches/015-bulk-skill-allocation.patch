diff --git a/MemoryPanel/web/src/pages/SkillsPage/components/AllocateSkillsDialog.tsx b/MemoryPanel/web/src/pages/SkillsPage/components/AllocateSkillsDialog.tsx
new file mode 100644
index 0000000..2b3318b
--- /dev/null
+++ b/MemoryPanel/web/src/pages/SkillsPage/components/AllocateSkillsDialog.tsx
@@ -0,0 +1,169 @@
+/** Batch reference bindings without copying or deleting skill content. */
+import { useEffect, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { Alert, Button, Checkbox, Input, Modal, Select } from 'tea-component';
+import { agentsApi, assetsApi } from '@/lib/teamApi';
+import '../styles/allocate-skills.css';
+
+type Skill = { asset_id: string; name: string };
+
+export default function AllocateSkillsDialog({ teamId, agents, initialAgentId, onChanged, onClose }: {
+  teamId: string;
+  agents: Array<{ id: string; name: string }>;
+  initialAgentId: string;
+  onChanged: () => void;
+  onClose: () => void;
+}) {
+  const { t } = useTranslation();
+  const [agentId, setAgentId] = useState(initialAgentId || agents[0]?.id || '');
+  const [data, setData] = useState<{ library: Skill[]; assigned: Skill[] } | null>(null);
+  const [leftSelected, setLeftSelected] = useState<string[]>([]);
+  const [rightSelected, setRightSelected] = useState<string[]>([]);
+  const [leftQuery, setLeftQuery] = useState('');
+  const [rightQuery, setRightQuery] = useState('');
+  const [loading, setLoading] = useState(true);
+  const [pending, setPending] = useState<'add' | 'remove' | null>(null);
+  const [error, setError] = useState('');
+  const [notice, setNotice] = useState('');
+  const [revision, setRevision] = useState(0);
+
+  useEffect(() => {
+    let cancelled = false;
+    setLoading(true);
+    setError('');
+    setData(null);
+    if (!agentId) {
+      setLoading(false);
+      return;
+    }
+    Promise.all([
+      // Include readable private skills so detached owned skills remain available.
+      assetsApi.listAccessible(teamId, { asset_type: 'skill', action: 'read' }),
+      agentsApi.getAssets(agentId, false),
+    ]).then(([library, assigned]) => {
+      if (cancelled) return;
+      const sort = (items: Skill[]) => items.sort((a, b) => a.name.localeCompare(b.name));
+      const assignedIds = new Set(assigned.map(item => item.asset_id));
+      setLeftSelected(ids => ids.filter(id => library.some(item => item.asset_id === id) && !assignedIds.has(id)));
+      setRightSelected(ids => ids.filter(id => assignedIds.has(id)));
+      setData({
+        library: sort(library.filter(item => item.status !== 'archived' && item.status !== 'deprecated')),
+        assigned: sort(assigned.filter(item => item.asset_type === 'skill')),
+      });
+    }).catch(error => {
+      if (!cancelled) setError(error instanceof Error ? error.message : String(error));
+    }).finally(() => {
+      if (!cancelled) setLoading(false);
+    });
+    return () => { cancelled = true; };
+  }, [teamId, agentId, revision]);
+
+  const busy = loading || pending !== null;
+  const assignedIds = new Set(data?.assigned.map(skill => skill.asset_id));
+  const available = data?.library.filter(skill => !assignedIds.has(skill.asset_id)) ?? [];
+  const assigned = data?.assigned ?? [];
+
+  async function transfer(direction: 'add' | 'remove') {
+    const ids = direction === 'add' ? leftSelected : rightSelected;
+    if (busy || !data || !agentId || ids.length === 0) return;
+    setPending(direction);
+    setError('');
+    setNotice('');
+    try {
+      // Read immediately before writing: retain all other asset types and binding options.
+      const current = await agentsApi.getFixedAssets(agentId);
+      const selected = new Set(ids);
+      const next = direction === 'remove'
+        ? current.filter(item => item.asset_type !== 'skill' || !selected.has(item.asset_id))
+        : [...current, ...ids.filter(id => !current.some(item => item.asset_id === id)).map(id => ({
+          asset_id: id, asset_type: 'skill' as const, injection_mode: 'reference' as const, priority: 50,
+        }))];
+      await agentsApi.setFixedAssets(agentId, next);
+      setLeftSelected([]);
+      setRightSelected([]);
+      setNotice(t(direction === 'add' ? 'skills.allocate.added' : 'skills.allocate.removed', { count: ids.length }));
+      setLoading(true);
+      setRevision(value => value + 1);
+      onChanged();
+    } catch (error) {
+      // Preserve the selection on failure so a retry applies the same batch.
+      setError(error instanceof Error ? error.message : String(error));
+    } finally {
+      setPending(null);
+    }
+  }
+
+  function column(side: 'available' | 'assigned', items: Skill[], selected: string[], query: string,
+    setSelected: (ids: string[]) => void, setQuery: (query: string) => void) {
+    const title = t(`skills.allocate.${side}`);
+    const visible = items.filter(skill => skill.name.toLocaleLowerCase().includes(query.trim().toLocaleLowerCase()));
+    const selectedVisible = visible.filter(skill => selected.includes(skill.asset_id)).length;
+    return (
+      <section className="_skill-transfer-column" aria-label={title}>
+        <div className="_skill-transfer-heading"><h3>{title}</h3><span>{items.length}</span></div>
+        <Input size="full" value={query} onChange={setQuery} disabled={pending !== null}
+          placeholder={t('skills.allocate.search')} aria-label={t('skills.allocate.searchIn', { list: title })} />
+        <div className="_skill-transfer-selection">
+          <Checkbox value={visible.length > 0 && selectedVisible === visible.length}
+            indeterminate={selectedVisible > 0 && selectedVisible < visible.length}
+            disabled={busy || !data || visible.length === 0}
+            onChange={checked => setSelected(checked
+              ? [...new Set([...selected, ...visible.map(skill => skill.asset_id)])]
+              : selected.filter(id => !visible.some(skill => skill.asset_id === id)))}>
+            {t('skills.allocate.selectAll')}
+          </Checkbox>
+          <span>{t('skills.allocate.selected', { count: selected.length })}</span>
+        </div>
+        <div className="_skill-transfer-list" aria-busy={busy}>
+          {loading ? <p>{t('common.loading')}</p> : !data ? <p>{t('skills.allocate.unavailable')}</p>
+            : visible.length === 0 ? <p>{t(query ? 'skills.allocate.noMatches'
+              : side === 'available' ? 'skills.allocate.emptyAvailable' : 'skills.allocate.emptyAssigned')}</p>
+            : visible.map(skill => (
+              <Checkbox key={skill.asset_id} className="_skill-transfer-row" value={selected.includes(skill.asset_id)}
+                disabled={pending !== null} title={skill.name}
+                onChange={checked => setSelected(checked ? [...selected, skill.asset_id]
+                  : selected.filter(id => id !== skill.asset_id))}>
+                <span>{skill.name}</span>
+              </Checkbox>
+            ))}
+        </div>
+      </section>
+    );
+  }
+
+  return (
+    <Modal visible caption={t('skills.allocate.title')} size={880} className="_skill-transfer-modal"
+      onClose={() => { if (!pending) onClose(); }} disableEscape={pending !== null} disableCloseIcon={pending !== null}>
+      <Modal.Body>
+        <div className="_skill-transfer-target">
+          <label id="skill-transfer-agent-label">{t('skills.allocate.agent')}</label>
+          <Select boxClassName="_skill-transfer-agent-options" aria-labelledby="skill-transfer-agent-label" size="full" value={agentId}
+            disabled={pending !== null || agents.length === 0} options={agents.map(agent => ({ value: agent.id, text: agent.name }))}
+            placeholder={t('skills.noAgent')} onChange={id => {
+              setAgentId(id); setData(null); setLoading(true); setLeftSelected([]); setRightSelected([]);
+              setRightQuery(''); setError(''); setNotice('');
+            }} />
+        </div>
+        {error && <Alert type="error"><span role="alert">{error}</span>{' '}
+          <Button type="link" disabled={busy} onClick={() => setRevision(value => value + 1)}>{t('skills.allocate.reload')}</Button>
+        </Alert>}
+        <div className="_skill-transfer-grid">
+          {column('available', available, leftSelected, leftQuery, setLeftSelected, setLeftQuery)}
+          <div className="_skill-transfer-actions">
+            <Button type="primary" disabled={busy || !data || leftSelected.length === 0}
+              loading={pending === 'add'} onClick={() => void transfer('add')}>
+              {t('skills.allocate.add')} <span aria-hidden="true">→</span>
+            </Button>
+            <Button disabled={busy || !data || rightSelected.length === 0}
+              loading={pending === 'remove'} onClick={() => void transfer('remove')}>
+              <span aria-hidden="true">←</span> {t('skills.allocate.remove')}
+            </Button>
+          </div>
+          {column('assigned', assigned, rightSelected, rightQuery, setRightSelected, setRightQuery)}
+        </div>
+        <div className="_skill-transfer-status" role="status" aria-live="polite">{notice}</div>
+      </Modal.Body>
+      <Modal.Footer><Button onClick={onClose} disabled={pending !== null}>{t('common.close')}</Button></Modal.Footer>
+    </Modal>
+  );
+}
