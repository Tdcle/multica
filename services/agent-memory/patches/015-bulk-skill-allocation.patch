diff --git a/MemoryPanel/web/src/pages/SkillsPage/styles/allocate-skills.css b/MemoryPanel/web/src/pages/SkillsPage/styles/allocate-skills.css
new file mode 100644
index 0000000..ece5ae7
--- /dev/null
+++ b/MemoryPanel/web/src/pages/SkillsPage/styles/allocate-skills.css
@@ -0,0 +1,88 @@
+._skill-transfer-target {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  margin-bottom: 16px;
+}
+._skill-transfer-target > label { flex: none; font-weight: 500; }
+._skill-transfer-target .tea-dropdown { width: 240px; max-width: 100%; }
+._skill-transfer-grid {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
+  align-items: stretch;
+  gap: 16px;
+}
+._skill-transfer-column {
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  padding: 12px;
+  border: 1px solid var(--tea-color-border-primary-default);
+  border-radius: var(--radius-lg);
+  background: var(--tea-color-bg-primary-default);
+}
+._skill-transfer-heading { display: flex; align-items: center; gap: 8px; margin-bottom: 12px; }
+._skill-transfer-heading h3 { margin: 0; font-size: var(--text-body); font-weight: 500; }
+._skill-transfer-heading > span, ._skill-transfer-selection > span { color: var(--tea-color-text-secondary); font-size: var(--text-caption); }
+._skill-transfer-selection { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 12px 4px 8px; }
+._skill-transfer-list {
+  height: min(360px, 40vh);
+  min-height: 120px;
+  overflow-y: auto;
+  overscroll-behavior: contain;
+  scrollbar-gutter: stable;
+}
+._skill-transfer-list > p { padding: 36px 12px; text-align: center; color: var(--tea-color-text-secondary); font-size: var(--text-body); }
+._skill-transfer-list ._skill-transfer-row {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  width: 100%;
+  min-height: 36px;
+  margin: 0;
+  padding: 8px;
+  border-radius: var(--radius-md);
+  cursor: pointer;
+}
+._skill-transfer-row:hover { background: var(--tea-color-bg-primary-hover); }
+._skill-transfer-row:has(input:checked) { background: var(--tea-color-bg-primary-active); }
+._skill-transfer-row:focus-within { outline: 2px solid var(--tea-color-border-primary-focus); outline-offset: -2px; }
+._skill-transfer-row .tea-form-check__label { min-width: 0; overflow-wrap: anywhere; }
+._skill-transfer-actions { display: flex; flex-direction: column; justify-content: center; gap: 8px; }
+._skill-transfer-actions .tea-btn { margin: 0; white-space: nowrap; }
+._skill-transfer-status { min-height: 20px; margin-top: 12px; color: var(--tea-color-text-secondary); font-size: var(--text-caption); }
+@media (max-width: 640px) {
+  ._skill-transfer-grid { grid-template-columns: minmax(0, 1fr); gap: 12px; }
+  ._skill-transfer-actions { flex-direction: row; }
+  ._skill-transfer-list { height: 160px; }
+  ._skill-transfer-target { align-items: flex-start; flex-direction: column; gap: 8px; }
+  ._skill-transfer-target .tea-dropdown { width: 100%; }
+}
+
+._skill-transfer-target .tea-dropdown__header {
+  padding: 6px 10px;
+  border: 1px solid var(--tea-color-border-primary-default);
+  border-radius: var(--radius-md);
+}
+._skill-transfer-column > .tea-input, ._skill-transfer-heading, ._skill-transfer-selection, ._skill-transfer-list { flex: none; }
+._skill-transfer-column .tea-form-check .tea-checkbox {
+  position: static;
+  flex: none;
+  margin: 0;
+  border-radius: var(--radius-sm);
+}
+._skill-transfer-selection .tea-form-check {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  padding: 0;
+  margin: 0;
+}
+
+/* Native checkmarks retain contrast in both Multica themes. */
+._skill-transfer-column input[type="checkbox"].tea-checkbox {
+  appearance: auto;
+  accent-color: var(--tea-color-text-primary);
+}
+._skill-transfer-column input[type="checkbox"].tea-checkbox:checked,
+._skill-transfer-column input[type="checkbox"].tea-checkbox:indeterminate { background-image: none; }
